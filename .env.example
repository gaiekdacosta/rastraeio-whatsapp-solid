# Supabase → Project Settings → API (ou Connect). Copie para .env e preencha.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). Em projetos antigos, use a "anon public" em VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Nunca coloque a service_role / secret key aqui: tudo que começa com VITE_ vai para o navegador.
